export io.github.qifan777.server.product.root.entity.Product

input ProductInput {
    #allScalars(Product)
    id
    id(category)
}
//ProductView{
//    #allScalars
//}

specification ProductSpec {
    #allScalars
    like/i(name)
    like/i(brand)
    associatedIdEq(category)
    like/i(description)
    associatedIdEq(creator)
    boxId: String?
}