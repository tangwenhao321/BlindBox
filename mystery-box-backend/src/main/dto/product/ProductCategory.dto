export io.github.qifan777.server.product.category.entity.ProductCategory

input ProductCategoryInput {
    #allScalars(ProductCategory)
    id
    id(parent)
}

specification ProductCategorySpec {
    #allScalars
    like/i(name)
    associatedIdEq(parent)
    like/i(description)
    associatedIdEq(creator)
}