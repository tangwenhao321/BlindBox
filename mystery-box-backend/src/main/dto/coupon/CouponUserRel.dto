export io.github.qifan777.server.coupon.user.entity.CouponUserRel

input CouponUserRelInput {
    #allScalars(CouponUserRel)
    id
    id(coupon)
    id(user)
}

specification CouponUserRelSpec {
    #allScalars
    associatedIdEq(creator)
    flat(coupon) {
        id as couponId
        le(thresholdAmount)
        le(effectiveDate)
        ge(expirationDate)
        status as couponStatus
    }
    associatedIdEq(user)
}