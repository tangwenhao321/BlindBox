# Development: Vite proxy forwards /api to http://localhost:9912
VITE_API_PREFIX=/api

# Set to vn for Vietnam province list in carriage templates
# VITE_MARKET=vn
# Optional money display for admin tables (defaults: vn→VND, else CNY)
# VITE_CURRENCY=VND

# Production: leave empty when admin dist is served by backend (same origin)
# VITE_API_PREFIX=

# Optional: HttpOnly cookie-primary auth (requires same-origin admin+API proxy).
# When true: axios withCredentials, JWT not stored in sessionStorage (see docs/ADMIN_SECURITY.md).
# VITE_ADMIN_COOKIE_AUTH=true
