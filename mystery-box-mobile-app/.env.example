# Dev machine LAN IP for physical devices (not 127.0.0.1 on device)
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:9912
# Dev-only mock OTP for register/reset flows (never set in production builds)
EXPO_PUBLIC_DEV_MOCK_OTP=000000
# Optional queue head timeout stub until backend config API is wired
# EXPO_PUBLIC_QUEUE_HEAD_TIMEOUT_SEC=120
# Windows: run npm run setup:android then restart terminal (sets ANDROID_HOME)
# ANDROID_HOME=%LOCALAPPDATA%\Android\Sdk
# --- Payment (dev only; production/preview EAS profiles force mock off) ---
EXPO_PUBLIC_PAYMENT_MODE=mock
EXPO_PUBLIC_MOCK_PAYMENT=true
# EAS production / production-vn: set EXPO_PUBLIC_API_BASE_URL via EAS secrets (HTTPS API host).
EXPO_PUBLIC_SUPPORT_PHONE=400-000-0000
EXPO_PUBLIC_ENTERPRISE_WECHAT_ID=your-wechat-id

# Optional crash reporting (install: npx expo install @sentry/react-native)
# EXPO_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# When DSN is set, app.config.js enables @sentry/react-native/expo for source maps in EAS builds.
# EAS production with Sentry source maps:
#   eas secret:create --name SENTRY_AUTH_TOKEN --value <token>
#   eas secret:create --name EXPO_PUBLIC_SENTRY_DSN --value <dsn>
#   eas build --profile production-sentry --platform all
# Set SENTRY_ORG / SENTRY_PROJECT in eas.json production-sentry profile or via EAS env.

# Maestro E2E (optional; used by .maestro/flows/login-smoke.yaml)
MAESTRO_TEST_PHONE=13800138000
MAESTRO_TEST_PASSWORD=Admin@123456
