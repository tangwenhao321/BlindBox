{
  "name": "mystery-box-mobile-app",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "expo start --port 8083",
    "start:8081": "expo start --port 8081",
    "start:go": "expo start --port 8083 --clear --go --lan",
    "prebuild": "expo prebuild",
    "prebuild:clean": "expo prebuild --clean",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "ios:device": "expo run:ios --device",
    "web": "expo start --web",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "tsc --noEmit && vitest run && npm run validate:maestro",
    "check:ci": "tsc --noEmit && vitest run --reporter=verbose && npm run a11y:audit && npm run validate:maestro",
    "check:bundle-budget": "node scripts/check-bundle-budget.mjs",
    "_comment_maestro": "Optional device smoke: MAESTRO_RUN_DEVICE=1 npm run test:e2e (see .maestro/README.md)",
    "a11y:audit": "node scripts/a11y-pressable-audit.mjs && node scripts/a11y-audit.mjs",
    "validate:maestro": "node scripts/validate-maestro-flows.mjs",
    "test:e2e": "maestro test .maestro/flows",
    "i18n:export": "node scripts/merge-locales.mjs",
    "i18n:index": "node scripts/generate-locale-index.mjs",
    "i18n:neutralize": "node scripts/neutralize-i18n-currency.mjs",
    "generate:sounds": "node scripts/generateRevealSounds.mjs",
    "ensure:icon": "node scripts/ensureAppIcon.mjs",
    "postinstall": "node scripts/ensureAppIcon.mjs && node scripts/generateRevealSounds.mjs",
    "eas-build-post-install": "node scripts/generateRevealSounds.mjs",
    "doctor": "npx expo-doctor",
    "setup:android": "powershell -ExecutionPolicy Bypass -File scripts/setup-android-sdk.ps1",
    "android:compile": "cd android && gradlew.bat assembleDebug --no-daemon"
  },
  "dependencies": {
    "@expo-google-fonts/be-vietnam-pro": "^0.4.1",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "^2.1.2",
    "@react-native-community/datetimepicker": "8.6.0",
    "@react-native-community/netinfo": "^11.4.1",
    "@shopify/flash-list": "^2.0.2",
    "@tanstack/query-async-storage-persister": "^5.90.2",
    "@tanstack/react-query": "^5.90.2",
    "@tanstack/react-query-persist-client": "^5.90.2",
    "axios": "^1.9.0",
    "babel-preset-expo": "~55.0.8",
    "buffer": "^6.0.3",
    "expo": "~55.0.26",
    "expo-application": "~55.0.15",
    "expo-asset": "~55.0.17",
    "expo-audio": "~55.0.14",
    "expo-file-system": "~55.0.9",
    "expo-font": "^55.0.8",
    "expo-haptics": "~55.0.8",
    "expo-image": "~55.0.5",
    "expo-image-picker": "~55.0.10",
    "expo-intent-launcher": "~55.0.8",
    "expo-linear-gradient": "~55.0.14",
    "expo-linking": "~55.0.15",
    "expo-local-authentication": "~55.0.8",
    "expo-localization": "55.0.15",
    "expo-media-library": "~55.0.17",
    "expo-navigation-bar": "~55.0.13",
    "expo-notifications": "~55.0.23",
    "expo-router": "~55.0.16",
    "expo-screen-capture": "~55.0.14",
    "expo-secure-store": "~55.0.8",
    "expo-sharing": "~55.0.20",
    "expo-status-bar": "~55.0.6",
    "expo-system-ui": "~55.0.18",
    "expo-web-browser": "~55.0.12",
    "i18next": "^26.3.0",
    "lottie-react-native": "~7.3.4",
    "react": "^19.2.0",
    "react-i18next": "^17.0.8",
    "react-native": "^0.83.6",
    "react-native-qrcode-svg": "^6.3.15",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "^4.25.2",
    "react-native-svg": "15.15.3",
    "react-native-view-shot": "4.0.3",
    "react-native-worklets": "0.7.4"
  },
  "optionalDependencies": {
    "@sentry/react-native": "^6.22.0",
    "react-native-wechat-lib": "^3.0.4"
  },
  "devDependencies": {
    "@types/react": "~19.2.10",
    "@vitest/coverage-v8": "^3.2.4",
    "typescript": "~5.9.2",
    "vitest": "^3.2.4"
  },
  "expo": {
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      }
    }
  }
}
