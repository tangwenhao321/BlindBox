{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_PAYMENT_MODE": "mock",
        "EXPO_PUBLIC_MOCK_PAYMENT": "true"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_PAYMENT_MODE": "mock",
        "EXPO_PUBLIC_MOCK_PAYMENT": "true",
        "EXPO_PUBLIC_APP_VARIANT": "preview"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_PAYMENT_MODE": "wechat",
        "EXPO_PUBLIC_MOCK_PAYMENT": "false",
        "EXPO_PUBLIC_APP_VARIANT": "production",
        "EXPO_PUBLIC_APP_CHANNEL": "appstore"
      },
      "channel": "production"
    },
    "production-sentry": {
      "extends": "production",
      "env": {
        "SENTRY_ORG": "",
        "SENTRY_PROJECT": "",
        "SENTRY_URL": "https://sentry.io/"
      }
    },
    "production-vn": {
      "extends": "production",
      "env": {
        "EXPO_PUBLIC_DEFAULT_LOCALE": "vi-VN",
        "EXPO_PUBLIC_CURRENCY": "VND",
        "EXPO_PUBLIC_PAYMENT_MODE": "vnpay",
        "EXPO_PUBLIC_MOCK_PAYMENT": "false",
        "EXPO_PUBLIC_APP_VARIANT": "production-vn",
        "EXPO_PUBLIC_APP_CHANNEL": "appstore",
        "EXPO_PUBLIC_PRIVACY_URL": "",
        "EXPO_PUBLIC_TERMS_URL": "",
        "EXPO_PUBLIC_MINOR_DECLARATION_URL": "",
        "EXPO_PUBLIC_APP_LINK_DOMAIN": "",
        "EXPO_PUBLIC_IOS_APP_STORE_URL": "",
        "EXPO_PUBLIC_SUPPORT_PHONE": "",
        "EXPO_PUBLIC_SUPPORT_EMAIL": "",
        "EXPO_PUBLIC_SENTRY_DSN": "",
        "SENTRY_ORG": "",
        "SENTRY_PROJECT": ""
      },
      "channel": "production-vn"
    }
  },
  "submit": {
    "production": {},
    "production-vn": {
      "extends": "production",
      "ios": {
        "ascAppId": ""
      }
    }
  }
}
