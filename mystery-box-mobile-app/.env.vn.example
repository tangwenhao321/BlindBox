# Vietnam production build — copy to .env or EAS secrets
EXPO_PUBLIC_APP_VARIANT=production-vn
EXPO_PUBLIC_EAS_PROJECT_ID=your-eas-project-uuid
EXPO_PUBLIC_DEFAULT_LOCALE=vi-VN
EXPO_PUBLIC_CURRENCY=VND
EXPO_PUBLIC_PAYMENT_MODE=vnpay
EXPO_PUBLIC_MOCK_PAYMENT=false
EXPO_PUBLIC_SUPPORT_PHONE=+84900000000
EXPO_PUBLIC_ZALO_OA_ID=your-zalo-oa-id

# Optional second wallet UI stub (requires backend MoMo gateway when enabled)
EXPO_PUBLIC_MOMO_ENABLED=false

# Legal pages — REQUIRED for production-vn EAS (build fails if empty/placeholder)
# Host real URLs (privacy / terms / minor declaration) before App Store submit.
EXPO_PUBLIC_PRIVACY_URL=https://your-domain.com/privacy
EXPO_PUBLIC_TERMS_URL=https://your-domain.com/terms
EXPO_PUBLIC_MINOR_DECLARATION_URL=https://your-domain.com/minor
EXPO_PUBLIC_SUPPORT_URL=https://your-domain.com/support
EXPO_PUBLIC_APP_STORE_URL=https://apps.apple.com/app/idXXXXXXXX
EXPO_PUBLIC_APP_LINK_DOMAIN=your-domain.com

# Optional override; iOS production defaults to appstore via EXPO_PUBLIC_APP_VARIANT.
# Do NOT set appstore on Android builds — clientAttestation ignores it there.
# EXPO_PUBLIC_APP_CHANNEL=appstore

# Invite / share attribution
EXPO_PUBLIC_INVITE_BASE_URL=https://your-domain.com/invite

# Backend SMS (prod-vn): SMS_PROVIDER=ali_yun + Aliyun credentials in server env
