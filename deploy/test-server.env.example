# 测试服务器环境变量模板
# 复制到服务器: /opt/mystery-box-test/.env
# 与四方系统 vipDistributionMall 隔离 — 勿共用 DB/Redis 库索引/端口

# ---------- 部署路径 ----------
DEPLOY_ROOT=/opt/mystery-box-test
APP_USER=mysterybox

# ---------- 后端 ----------
SPRING_PROFILES_ACTIVE=testenv,private-test
TEST_SERVER_PORT=9913
JAVA_OPTS=-Xms512m -Xmx1024m

# ---------- MySQL（推荐独立库 + 独立账号；可与四方同实例不同库） ----------
# 四方 vipDistributionMall 通常: DB vip @ 3306 — 本环境用 mystery_box_test
TEST_DB_HOST=127.0.0.1
TEST_DB_PORT=3306
TEST_DB_USERNAME=mystery_box_test
TEST_DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

# ---------- Redis（推荐 DB index 1；四方常用 6380/0） ----------
TEST_REDIS_HOST=127.0.0.1
TEST_REDIS_PORT=6380
TEST_REDIS_PASSWORD=
# 或直接整串（优先级更高）:
# REDIS_URL=redis://:password@127.0.0.1:6380/1

# ---------- 管理端构建 ----------
VITE_API_PREFIX=/api

# ---------- 公网访问（Nginx 反代后填写，用于 App .env.test） ----------
PUBLIC_API_BASE_URL=https://test-api.your-domain.com
PUBLIC_ADMIN_URL=https://test-admin.your-domain.com

# ---------- 安全 ----------
ADMIN_ACTION_OTP=TestEnvOtp2026!
DEFAULT_ADMIN_PASSWORD=Admin@Test2026
PAYMENT_MOCK_ENABLED=true

# ---------- 上传目录（与四方分离） ----------
UPLOAD_DIR=/opt/mystery-box-test/data/uploads-test
