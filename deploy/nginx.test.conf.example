# 测试环境 Nginx 示例（与生产 / 四方 使用不同 server_name 与 upstream 端口）

upstream mystery_box_test_api {
    server 127.0.0.1:9913;
}

server {
    listen 8088;
    server_name test-mysterybox.local;

    client_max_body_size 20m;

    location / {
        proxy_pass http://mystery_box_test_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /uploads/ {
        proxy_pass http://mystery_box_test_api/uploads/;
    }
}

server {
    listen 8089;
    server_name test-admin-mysterybox.local;
    root /var/www/mystery-box-admin-test/dist;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location /api/ {
        proxy_pass http://mystery_box_test_api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location /uploads/ {
        proxy_pass http://mystery_box_test_api/uploads/;
    }
}
