# 测试服务器 Nginx（与四方 vipDistributionMall 隔离）
# - 四方通常: /api -> :3000 或独立域名
# - 本环境: test-api.* -> :9913, test-admin.* -> 静态目录
#
# 安装:
#   sudo cp deploy/nginx.test-server.conf.example /etc/nginx/conf.d/mystery-box-test.conf
#   sudo nginx -t && sudo systemctl reload nginx

upstream mystery_box_test_api {
    server 127.0.0.1:9913;
    keepalive 16;
}

# ---------- API（手机 App / 管理端 AJAX） ----------
server {
    listen 80;
    server_name test-api.your-domain.com;

    client_max_body_size 25m;

    location / {
        proxy_pass http://mystery_box_test_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    location /uploads/ {
        alias /opt/mystery-box-test/data/uploads-test/;
        expires 7d;
        add_header Cache-Control "public";
    }
}

# ---------- 管理端静态 ----------
server {
    listen 80;
    server_name test-admin.your-domain.com;
    root /opt/mystery-box-test/releases/admin-dist;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location /api/ {
        proxy_pass http://mystery_box_test_api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /uploads/ {
        proxy_pass http://mystery_box_test_api/uploads/;
    }
}

# HTTPS: 使用 certbot 或面板证书，将 listen 443 ssl 与证书路径补上
