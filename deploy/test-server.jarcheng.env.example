# jarcheng.top 测试服务器 — 复制到 /opt/mystery-box-test/.env
# 与四方 vipDistributionMall 同机隔离：独立库 mystery_box_test、Redis DB 1、端口 9913

DEPLOY_ROOT=/opt/mystery-box-test
APP_USER=mysterybox

SPRING_PROFILES_ACTIVE=testenv,private-test
TEST_SERVER_PORT=9913
JAVA_OPTS=-Xms512m -Xmx1024m

# 共用服务器 MySQL（四方 vip 库在 3306，本环境仅新建 mystery_box_test）
TEST_DB_HOST=127.0.0.1
TEST_DB_PORT=3306
TEST_DB_USERNAME=mystery_box_test
TEST_DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

# 四方常用 6380/0 — 盲盒测试用 DB 1
REDIS_URL=redis://127.0.0.1:6380/1

VITE_API_PREFIX=/test-admin/api
# 管理端部署在 www.jarcheng.top/test-admin/ 时启用
VITE_BASE=/test-admin/

PUBLIC_API_BASE_URL=https://www.jarcheng.top/test-api
PUBLIC_ADMIN_URL=https://www.jarcheng.top/test-admin

ADMIN_ACTION_OTP=TestEnvOtp2026!
DEFAULT_ADMIN_PASSWORD=Admin@Test2026
PAYMENT_MOCK_ENABLED=true
UPLOAD_DIR=/opt/mystery-box-test/data/uploads-test
