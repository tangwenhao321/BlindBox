/template/
bundle*.txt
*.rar

# ---- Build noise / local scratch ----
*.tsbuildinfo
mystery-box-backend/scripts/compile.out
mystery-box-backend/scripts/dc-raw.java
mystery-box-backend/scripts/*.class
