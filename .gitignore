# Native build output. The prebuilt android/ sources are tracked; their build products are not.
mystery-box-mobile-app/android/build/
mystery-box-mobile-app/android/app/build/
mystery-box-mobile-app/android/.gradle/
mystery-box-mobile-app/android/.kotlin/
mystery-box-mobile-app/android/local.properties
mystery-box-mobile-app/ios/build/
mystery-box-mobile-app/ios/Pods/

# Reveal SFX are generated by `npm run generate:sounds`, not committed.
mystery-box-mobile-app/src/assets/sounds/*.wav
mystery-box-mobile-app/src/assets/sounds/*.mp3
mystery-box-mobile-app/src/assets/sounds/*.ogg

